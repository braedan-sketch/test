  "scenes": [
    {
      "id": "s01",
      "name": "Igloo hero + fog transition",
      "start_frame": 0,
      "end_frame": 261,
      "frame_count": 262,
      "duration_seconds": 10.916667,
      "description": "Frosted igloo blocks settle on a snowy mound, camera pulls back to the hero framing, then fog rolls up with rainbow leaks into a whiteout. Sub-beats (approx): hero settle + pullback 0-144; fog dive to whiteout 145-261.",
      "overlay_hint": "Title/logo overlays work over the hero pullback (frames 0-144). Fade them before the fog swallows the igloo (from ~145)."
    },
    {
      "id": "s03",
      "name": "Falling rocks + transition into rings",
      "start_frame": 262,
      "end_frame": 708,
      "frame_count": 447,
      "duration_seconds": 18.625,
      "description": "Camera falls through pale haze as faceted frosted rocks in thin wireframe boxes rise through frame; ring pieces then assemble and the view tilts top-down. Sub-beats (approx): first rock 262-402; second rock 403-543; rings assemble 544-708.",
      "overlay_hint": "Callout labels can sit in the mid-frame haze beside each rock (262-543). Clear them as the rings take over (~544)."
    },
    {
      "id": "s04",
      "name": "Camera dive through the rings to the core",
      "start_frame": 709,
      "end_frame": 1157,
      "frame_count": 449,
      "duration_seconds": 18.708333,
      "description": "Rings stay put while the camera drops straight down the centre; each ring glows, passes around the frame edges and reveals the next. They flatten into etched circles and the core lands on the glowing disc. Sub-beats (approx): outer ring descent 709-849; pulse to next rings 850-1000; final sweep, flatten, core on disc 1001-1157.",
      "overlay_hint": "Keep overlays minimal and at the edges; the rings use the full 16:9 frame. A centre-safe title can land as the core settles (~1100-1157)."
    },
    {
      "id": "s05",
      "name": "Particle figure + transition into rebuild",
      "start_frame": 1158,
      "end_frame": 1612,
      "frame_count": 455,
      "duration_seconds": 18.958333,
      "description": "The core rises into a chubby bear-like particle figure on a stepped glowing disc under a white halo; camera tilts from top-down to a low hero angle and orbits, then the disc ripples with rainbow fringing and melts into a snowy mountain. Sub-beats (approx): tilt up / figure forms 1158-1306; orbit to hero angle 1307-1447; ripple, fade, mountain + shards 1448-1612.",
      "overlay_hint": "Figure hero copy works during the low-angle orbit (1307-1447). Fade it as the disc ripples (~1448)."
    },
    {
      "id": "s06",
      "name": "Shards fly up, igloo rebuilds, loop back to hero",
      "start_frame": 1613,
      "end_frame": 2013,
      "frame_count": 401,
      "duration_seconds": 16.708333,
      "description": "The figure dissolves under a rainbow halo, ice shards and white blocks fly up, a thin wireframe dome flashes and the igloo assembles course by course, settling into scene 1's first frame so the sequence loops. Sub-beats (approx): shards + figure fade 1613-1733; assembly 1734-1917; glide into hero framing 1918-2013. Last frame flows into frame 0 (loop MAD ~1.1).",
      "overlay_hint": "End-card or loop CTA can appear as the igloo settles (1918-2013). This range should match the opening hero overlays."
    }
  ],
